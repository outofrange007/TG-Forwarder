# ============================================================
#  Telegram Forwarder - configuration
#  Copy to .env and fill in the values. NEVER commit .env!
# ============================================================

# --- Credentials from https://my.telegram.org -> "API development tools" ---
API_ID=1234567
API_HASH=your_api_hash_here

# Optional instead of a session file: SESSION_STRING (python -m forwarder login --print-session-string)
SESSION_STRING=

# --- Source and target ---
# Allowed: numeric ID (-1001234567890), @username, https://t.me/name, https://t.me/c/1234567890/1
# Find IDs with: python -m forwarder chats  (or in the dashboard)
SOURCE_CHAT=-1001111111111
TARGET_CHAT=-1002222222222

# Only transfer messages from this topic of the source (the source must be a forum).
# Empty, 0 or all = all topics; 1 = "General". Show IDs: python -m forwarder topics
SOURCE_TOPIC_ID=

# Topic mode in the target: none | fixed | mirror
#   none   = no topic ("General")
#   fixed  = everything into TARGET_TOPIC_ID
#   mirror = create/reuse topics of the source with the same name in the target (needs the "Manage topics" admin right)
TOPIC_MODE=none
TARGET_TOPIC_ID=

# --- Behavior ---
# copy    = re-send media, no "Forwarded from" (default)
# forward = real forward
MODE=copy
# With MODE=forward: hide the sender (like "forward without sender")
HIDE_SENDER=true

# Media types: photo, video, animation (GIF), video_note (round video),
#              image_file (image as file), video_file (video as file) or "all"
MEDIA_TYPES=photo,video,image_file,video_file

# Caption. Placeholders: {caption} {filename} {source} {link} {id} {date}
# Leave empty = no caption. Line break with \n
CAPTION_TEMPLATE={caption}

# Pause between two sends in seconds (protects against FloodWait)
DELAY_SECONDS=2

# Narrowing down (everything optional)
START_FROM_ID=
END_AT_ID=
DATE_FROM=
DATE_TO=
MAX_FILE_SIZE_MB=2000

# If the source has content protection: download and re-upload
DOWNLOAD_FALLBACK=true
# Also copy plain text messages (without photo/video)
COPY_TEXT=false
# On the next start, continue from the last processed message
RESUME=true
# Dry run: send nothing, only log
DRY_RUN=false
MAX_RETRIES=3

# --- Infrastructure ---
DATA_PATH=./data
WEB_HOST=0.0.0.0
WEB_PORT=5000
# Password protection for the dashboard (HTTP Basic Auth, any username). Strongly recommended!
WEB_PASSWORD=
LOG_LEVEL=INFO
